# PlusSent — env template. Copy to .env.local. NEVER commit real keys.
# Database: local file by default; set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN for hosted libSQL.
DATABASE_URL=file:./data/plussent.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 32+ byte secret for AES-256-GCM credential encryption (generate: openssl rand -hex 32)
ENCRYPTION_KEY=
SESSION_SECRET=
APP_URL=http://localhost:3000
# Email sending (SMTP) — required for real sending / verification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@plussent.com
# OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# AI providers (optional until configured — see src/lib/ai/providers.ts)
MUSE_API_URL=
MUSE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Billing (optional until configured)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
# Admin seed (first run only)
ADMIN_EMAILS=
